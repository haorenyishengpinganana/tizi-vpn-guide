---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { getPublishedPosts, fmtDate, fmtDateZh } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const d = post.data;
const zh = d.lang === 'zh';
const date = zh ? fmtDateZh : fmtDate;
const t = zh
  ? { home: '首页', homeHref: url(), published: '发布于', updated: '更新于', sources: '参考来源', toc: '本文目录', full: '完整版请看：', fullLink: '阅读完整指南 →',
      disclosure: '披露：本文含推广/邀请链接，通过链接注册或购买，本站可能获得佣金，你的价格不受影响。推荐内容只写可核实的信息。' }
  : { home: 'Home', homeHref: url('en/'), published: 'Published', updated: 'Updated', sources: 'Sources', toc: 'On this page', full: 'Want the full guide? ', fullLink: 'Read the in-depth version →',
      disclosure: 'Disclosure: this article contains referral links. We may earn a commission if you sign up, at no extra cost to you.' };
---

<Base title={d.title} description={d.description} type="article" published={d.pubDate} lang={d.lang}>
  <div class="article-layout">
    <article class="article">
      <header class="article-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href={t.homeHref}>{t.home}</a></li><li>{d.title}</li></ol></nav>
        {d.tags.length > 0 && <span class="eyebrow">{d.tags[0]}</span>}
        <h1>{d.title}</h1>
        <p class="meta">
          {t.published} <time datetime={d.pubDate.toISOString()}>{date(d.pubDate)}</time>
          {d.updatedDate && <> · {t.updated} <time datetime={d.updatedDate.toISOString()}>{date(d.updatedDate)}</time></>}
          · {d.sources.length} {zh ? '个参考来源' : 'sources'}
        </p>
        {d.hasAffiliateLinks && <p class="notice disclosure">{t.disclosure}</p>}
        <p class="lead">{d.description}</p>
      </header>
      <div class="prose"><Content /></div>
      {d.mainSitePost && <p class="notice">{t.full}<a href={d.mainSitePost}>{t.fullLink}</a></p>}
      <section class="sources">
        <h2>{t.sources}</h2>
        <ol>{d.sources.map((s) => <li><a href={s.url} rel="nofollow noopener">{s.title}</a></li>)}</ol>
      </section>
    </article>
    <aside>
      {toc.length > 2 && (
        <nav class="toc" aria-label={t.toc}>
          <p>{t.toc}</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </aside>
  </div>
</Base>
