---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { getPublishedPosts, fmtDate, fmtDateZh } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const zh = d.lang === 'zh';
const date = zh ? fmtDateZh : fmtDate;
const t = zh
  ? { home: '首页', homeHref: url('zh/'), published: '发布于', updated: '更新于', sources: '参考来源', full: '完整版请看：', fullLink: '阅读完整指南 →',
      disclosure: '披露：本文含推广/邀请链接，通过链接注册或购买，本站可能获得佣金，你的价格不受影响。推荐内容只写可核实的信息。' }
  : { home: 'Home', homeHref: url(), published: 'Published', updated: 'Updated', sources: 'Sources', full: 'Want the full guide? ', fullLink: 'Read the in-depth version →',
      disclosure: 'Disclosure: this article contains referral links. We may earn a commission if you sign up, at no extra cost to you.' };
---

<Base title={d.title} description={d.description} type="article" published={d.pubDate} lang={d.lang}>
  <article class="article">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href={t.homeHref}>{t.home}</a></li><li>{d.title}</li></ol></nav>
    <h1>{d.title}</h1>
    <p class="meta">
      {t.published} <time datetime={d.pubDate.toISOString()}>{date(d.pubDate)}</time>
      {d.updatedDate && <> · {t.updated} <time datetime={d.updatedDate.toISOString()}>{date(d.updatedDate)}</time></>}
    </p>
    {d.hasAffiliateLinks && <p class="notice">{t.disclosure}</p>}
    <p class="lead">{d.description}</p>
    <div class="prose"><Content /></div>
    {d.mainSitePost && <p class="notice">{t.full}<a href={d.mainSitePost}>{t.fullLink}</a></p>}
    <section class="related">
      <h2>{t.sources}</h2>
      <ul>{d.sources.map((s) => <li><a href={s.url} rel="nofollow noopener">{s.title}</a></li>)}</ul>
    </section>
  </article>
</Base>
