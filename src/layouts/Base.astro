---
import { SITE } from '../config';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  published?: Date;
  lang?: 'en' | 'zh';
  keywords?: string[];
  jsonLd?: object[];
}
const { title, description, type = 'website', published, lang = 'en', keywords = [], jsonLd = [] } = Astro.props;
const zh = lang === 'zh';
const brand = zh ? SITE.nameZh : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes(brand) ? title : `${title} | ${brand}`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const nav = [
  { href: url(), label: '首页', active: path === '/' },
  { href: url('zh/'), label: '全部文章', active: path === '/zh/' },
  { href: url('en/'), label: 'English', active: path.startsWith('/en') },
  { href: url('rss.xml'), label: 'RSS', active: false },
];
---

<!doctype html>
<html lang={zh ? 'zh-CN' : SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('rss.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content={zh ? 'zh_CN' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{zh ? '跳到正文' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={url()}>{SITE.nameZh} <span class="logo-en">{SITE.name}</span></a>
        <nav><ul>{nav.map((n) => <li><a href={n.href} aria-current={n.active ? 'page' : undefined}>{n.label}</a></li>)}</ul></nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        {SITE.mainSite.url && (
          <p>{zh ? '更多 VPN 深度指南：' : 'In-depth VPN guides: '}<a href={SITE.mainSite.url}>{SITE.mainSite.name || SITE.mainSite.url}</a></p>
        )}
        <p>{zh ? '本站内容仅作技术科普，部分链接为推广链接，详见文内披露。' : 'Some links are referral links; see in-article disclosures.'}</p>
        <p>© {new Date().getFullYear()} {SITE.nameZh} · {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
