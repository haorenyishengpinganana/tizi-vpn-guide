---
import { SITE } from '../config';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  published?: Date;
  lang?: 'en' | 'zh';
}
const { title, description, type = 'website', published, lang = 'en' } = Astro.props;
const htmlLang = lang === 'zh' ? 'zh-CN' : SITE.lang;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('rss.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={url()}>{SITE.name}</a>
        <nav><ul><li><a href={url()}>Articles</a></li><li><a href={url('zh/')}>中文</a></li><li><a href={url('rss.xml')}>RSS</a></li></ul></nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        {SITE.mainSite.url && (
          <p>In-depth VPN guides: <a href={SITE.mainSite.url}>{SITE.mainSite.name || SITE.mainSite.url}</a></p>
        )}
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
